# Loaded by src/__init__.py when the API or the tests start.
# Alias of the registered model to serve (the deployment pipeline sets it).
ENV=staging
# MLflow store: a path relative to this folder or a URI (file:///app/mlruns, http://...).
# `mlruns` is the small store shipped with the API; use ../pipeline/mlruns for a model
# you trained yourself.
MLFLOW_SERVER=mlruns
MLFLOW_REGISTRY_NAME=purchase_predict
API_PORT=5003
