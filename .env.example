# Variables used by the project. Copy the first block to api/.env for the API; the
# pipeline reads a .env in pipeline/ or the shell environment.

# --- MLflow (pipeline/ and api/) ---
# Alias given to the registered model by the deployment pipeline, and loaded by the API.
ENV=staging
# Tracking store. The pipeline defaults to ./mlruns inside pipeline/. The API accepts a
# path relative to api/ (mlruns = the small store shipped with it) or a URI.
MLFLOW_SERVER=mlruns
MLFLOW_REGISTRY_NAME=purchase_predict
API_PORT=5003

# --- Google Cloud, only for the GCS-backed loading pipeline and tests ---
GCP_PROJECT_ID=your-gcp-project-id
GCS_PRIMARY_FOLDER=your-gcs-bucket/data/03_primary
GCS_TEST_FOLDER=your-gcs-bucket/data-test.csv
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Cloud Build scripts in deploy/scripts ---
BUCKET=your-gcs-bucket
